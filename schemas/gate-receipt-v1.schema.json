{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://be90nia.github.io/Lottery/schemas/gate-receipt-v1.schema.json",
  "title": "Lottery typed gate receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_type",
    "gate_id",
    "release_id",
    "source_commit",
    "release_manifest_sha256",
    "result",
    "checks",
    "generated_at_utc"
  ],
  "properties": {
    "schema": {
      "const": "lottery.gate-receipt/v1"
    },
    "receipt_type": {
      "enum": [
        "source-build-integrity",
        "canonical-data-source-evidence",
        "numerical-engine",
        "experimental-validity",
        "population-regime-validity",
        "champion-lifecycle-serving",
        "feedback-monitoring",
        "durable-storage-recovery",
        "security-operations"
      ]
    },
    "gate_id": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8"
      ]
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result": {
      "const": "PASS"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "PASS"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
