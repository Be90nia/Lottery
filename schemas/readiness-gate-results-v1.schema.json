{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://be90nia.github.io/Lottery/schemas/readiness-gate-results-v1.schema.json",
  "title": "Lottery release gate results v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["gate_id", "status", "evidence"],
    "properties": {
      "gate_id": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"]},
      "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"]},
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      },
      "note": {"type": "string"}
    }
  }
}