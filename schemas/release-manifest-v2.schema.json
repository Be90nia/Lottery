{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://be90nia.github.io/Lottery/schemas/release-manifest-v2.schema.json",
  "title": "Lottery complete release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "release_ref",
    "source_commit",
    "lot042_accessed",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "lottery.release-manifest/v2"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "release_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "lot042_accessed": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_policy",
        "dependency_lock",
        "readiness_policy",
        "canonical_snapshot",
        "source_evidence_ledger",
        "runtime_toolchain",
        "sbom",
        "security_scan",
        "experiment_registration",
        "evaluation_manifests",
        "champion_registry_snapshot",
        "model_artifacts",
        "sampler_rng",
        "storage_commit_receipts",
        "backup_generation",
        "independent_restore_receipt"
      ],
      "properties": {
        "workflow_policy": {
          "$ref": "#/$defs/evidenceRef"
        },
        "dependency_lock": {
          "$ref": "#/$defs/evidenceRef"
        },
        "readiness_policy": {
          "$ref": "#/$defs/evidenceRef"
        },
        "canonical_snapshot": {
          "$ref": "#/$defs/evidenceRef"
        },
        "source_evidence_ledger": {
          "$ref": "#/$defs/evidenceRef"
        },
        "runtime_toolchain": {
          "$ref": "#/$defs/evidenceRef"
        },
        "sbom": {
          "$ref": "#/$defs/evidenceRef"
        },
        "security_scan": {
          "$ref": "#/$defs/evidenceRef"
        },
        "experiment_registration": {
          "$ref": "#/$defs/evidenceRef"
        },
        "champion_registry_snapshot": {
          "$ref": "#/$defs/evidenceRef"
        },
        "sampler_rng": {
          "$ref": "#/$defs/evidenceRef"
        },
        "storage_commit_receipts": {
          "$ref": "#/$defs/evidenceRef"
        },
        "backup_generation": {
          "$ref": "#/$defs/evidenceRef"
        },
        "independent_restore_receipt": {
          "$ref": "#/$defs/evidenceRef"
        },
        "evaluation_manifests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "model_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
